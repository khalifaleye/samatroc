// SamaTroc - Schéma de base de données
// Plateforme sénégalaise d'échange d'objets entre particuliers
// Note : le connecteur SQLite ne supporte pas les enums Prisma.
// Les statuts sont stockés en String et validés côté application (src/lib/constants.ts).
// Le schéma est conçu pour être portable vers PostgreSQL en production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// UTILISATEURS & PROFILS
// ==========================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?
  city          String?
  role          String   @default("USER") // USER | ADMIN | SUPER_ADMIN
  status        String   @default("ACTIVE") // ACTIVE | SUSPENDED
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  isDemo        Boolean  @default(false) // comptes de démonstration
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile           Profile?
  listings          Listing[]
  favorites         Favorite[]
  payments          Payment[]
  proposalsSent     ExchangeProposal[]   @relation("ProposerProposals")
  conversationsA    Conversation[]       @relation("ConversationUserA")
  conversationsB    Conversation[]       @relation("ConversationUserB")
  messages          Message[]
  notifications     Notification[]
  reportsFiled      Report[]             @relation("ReportReporter")
  reportsHandled    Report[]             @relation("ReportHandler")
  blocksIssued      Block[]              @relation("BlockBlocker")
  blocksReceived    Block[]              @relation("BlockBlocked")
  resetTokens       PasswordResetToken[]
  verifyTokens      VerificationToken[]
  adminLogs         AdminLog[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model Profile {
  id              String  @id @default(cuid())
  userId          String  @unique
  bio             String?
  quartier        String?
  showPhone       Boolean @default(false)
  whatsappEnabled Boolean @default(true)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// RÉFÉRENTIELS (catégories, villes)
// ==========================================

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  icon      String     @default("package")
  color     String     @default("#0E5C3D")
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  listings  Listing[]  @relation("ListingCategory")
  subList   Listing[]  @relation("ListingSubcategory")

  @@index([slug])
  @@index([sortOrder])
}

model City {
  id       String  @id @default(cuid())
  name     String  @unique
  region   String?
  isActive Boolean @default(true)
}

// ==========================================
// ANNONCES
// ==========================================

model Listing {
  id              String    @id @default(cuid())
  reference       String    @unique // ST-ANN-XXXXXX
  userId          String
  title           String
  description     String
  categoryId      String
  subcategoryId   String?
  condition       String    @default("BON") // NEUF | TRES_BON | BON | SATISFAISANT
  city            String
  quartier        String?
  wantedText      String // ce que l'utilisateur recherche en échange
  wantedCategory  String?
  wantedMultiple  Boolean   @default(false)
  status          String    @default("DRAFT") // DRAFT | PENDING_PAYMENT | PENDING_MODERATION | PUBLISHED | REFUSED | DEACTIVATED | EXCHANGED
  moderationNote  String?
  refusalReason   String?
  featured        Boolean   @default(false)
  viewsCount      Int       @default(0)
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category           @relation("ListingCategory", fields: [categoryId], references: [id])
  subcategory   Category?          @relation("ListingSubcategory", fields: [subcategoryId], references: [id])
  images        ListingImage[]
  favorites     Favorite[]
  payments      Payment[]
  proposals     ExchangeProposal[] @relation("ProposalTargetListing")
  offeredIn     ExchangeProposal[] @relation("ProposalOfferedListing")
  conversations Conversation[]

  @@index([status])
  @@index([city])
  @@index([categoryId])
  @@index([userId])
  @@index([createdAt])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  url       String
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// ==========================================
// PAIEMENTS (frais de publication)
// ==========================================

model Payment {
  id          String    @id @default(cuid())
  reference   String    @unique // ST-PAY-XXXXXX
  userId      String
  listingId   String?
  amount      Int // montant en FCFA (frais de publication)
  provider    String // WAVE | ORANGE_MONEY | TEST
  method      String?
  status      String    @default("PENDING") // PENDING | PROCESSING | SUCCESS | FAILED | EXPIRED | REFUNDED
  phone       String?
  providerRef String?
  isTest      Boolean   @default(false)
  metadata    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([listingId])
}

// ==========================================
// PROPOSITIONS D'ÉCHANGE
// ==========================================

model ExchangeProposal {
  id               String    @id @default(cuid())
  listingId        String // annonce ciblée
  proposerId       String // auteur de la proposition
  offeredListingId String? // annonce personnelle proposée (facultatif)
  offeredText      String? // description de l'objet proposé hors annonce
  offeredImages    String? // JSON array d'URLs
  message          String?
  counterText      String? // contre-proposition du propriétaire
  status           String    @default("PENDING") // PENDING | ACCEPTED | REFUSED | DISCUSSING | CANCELLED | COMPLETED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  respondedAt      DateTime?
  completedAt      DateTime?

  listing        Listing  @relation("ProposalTargetListing", fields: [listingId], references: [id], onDelete: Cascade)
  proposer       User     @relation("ProposerProposals", fields: [proposerId], references: [id], onDelete: Cascade)
  offeredListing Listing? @relation("ProposalOfferedListing", fields: [offeredListingId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([proposerId])
  @@index([status])
}

// ==========================================
// MESSAGERIE
// ==========================================

model Conversation {
  id            String   @id @default(cuid())
  listingId     String?
  userAId       String // toujours l'id lexicographiquement inférieur
  userBId       String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  userA    User     @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User     @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  listing  Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([listingId, userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@index([lastMessageAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String?
  type           String    @default("TEXT") // TEXT | IMAGE | SYSTEM
  content        String
  imageUrl       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([readAt])
}

// ==========================================
// FAVORIS & NOTIFICATIONS
// ==========================================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String // PROPOSAL_RECEIVED | PROPOSAL_ACCEPTED | PROPOSAL_REFUSED | PROPOSAL_COMPLETED | MESSAGE | PAYMENT_CONFIRMED | LISTING_PUBLISHED | LISTING_REFUSED | LISTING_EXPIRED | REPORT_UPDATE | SYSTEM
  title      String
  body       String
  linkView   String?
  linkParams String? // JSON
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

// ==========================================
// CONFIANCE & SÉCURITÉ
// ==========================================

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  targetType  String // LISTING | USER | MESSAGE
  targetId    String
  reason      String // FRAUDE | CONTENU_INTERDIT | ARNAQUE | OFFENSANT | CONTREFACON | AUTRE
  details     String?
  status      String   @default("PENDING") // PENDING | RESOLVED | DISMISSED
  resolution  String?
  handledById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter  User    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  handledBy User?   @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([reporterId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
}

// ==========================================
// CONTENU & PARAMÈTRES DU SITE
// ==========================================

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SiteContent {
  page      String   @id // ABOUT | HOW_IT_WORKS | FAQ | SAFETY | CGU | PRIVACY | MODERATION | CONTACT
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

// ==========================================
// SÉCURITÉ DES COMPTES
// ==========================================

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      String // EMAIL | PHONE
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
